# Copier ce fichier en `secrets.env` sur la VM (jamais versionné) puis remplacer la valeur.
# Générer un jeton : openssl rand -hex 32
# Le même jeton est lu par l'API (Authentication__AppToken) et posé par Nginx sur /api/ (APP_TOKEN).
APP_TOKEN=remplacez-moi-par-openssl-rand-hex-32
Authentication__AppToken=remplacez-moi-par-openssl-rand-hex-32
